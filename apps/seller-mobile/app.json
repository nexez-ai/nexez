{
  "expo": {
    "name": "Nexez Seller Hub",
    "slug": "nexez-seller-hub",
    "owner": "nexez-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nexez-seller",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.nexez.sellerhub",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.nexez.sellerhub",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0a0e16",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0a0e16"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#E45F38",
          "defaultChannel": "seller-events"
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-status-bar",
      [
        "@sentry/react-native/expo",
        {
          "organization": "nexez-ai",
          "project": "nexez-seller-hub"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0ebc7964-9099-4b42-b569-da181c30d155"
      }
    }
  }
}
